<?xml version="1.0" encoding="utf-8"?>
<!--
  Disposable sandbox lab only. debug-overrides is ignored unless the app is
  debuggable, so the lab CA and the local TLS fixture CA below never become
  production defaults. Production keeps the main system-only configuration.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/lab_ca" />
            <certificates src="@raw/admin_fixture_ca" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
